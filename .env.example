# ──────────────────────────────────────────────────────────────────────────
# Environment configuration for the Lotto Journal monorepo.
# Copy this file to `.env.local` and fill in your values.
# $ cp .env.example .env.local
#
# Usage Method: Centralized Monorepo Setup
# - Used by pnpm, docker-compose, and Makefiles from the repository root.
# - Do NOT use quotes around values — this file is read by both shell and Make.
# ──────────────────────────────────────────────────────────────────────────

# ── Database ───────────────────────────────────────────────────────────────────
# Used by docker-compose to create the PostgreSQL container.

DB_USERNAME=postgres
DB_PASSWORD=yourpassword
DB_NAME=lotto_journal

# ── App ────────────────────────────────────────────────────────────────────────
# Used by the Go API (apps/api). DB_DSN must match the DB_* values above.

DB_DSN=postgres://postgres:yourpassword@localhost:5432/lotto_journal?sslmode=disable
# DB_MAX_IDLE_CONNS=0
# DB_MAX_OPEN_CONNS=5
# DB_CONN_MAX_LIFETIME=3m
# DB_CONN_MAX_IDLE_TIME=1m
PORT=:3000
APP_ENV=development

# ── LINE Messaging API ─────────────────────────────────────────────────────────
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# ── Cloudflare R2 Storage ──────────────────────────────────────────────────────
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=your_r2_bucket_name_here
R2_PUBLIC_URL_PREFIX=https://pub-yourdomain.r2.dev

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── Job Trigger / Cron Secret ──────────────────────────────────────────────────
CRON_SECRET=local-cron-secret-change-me
